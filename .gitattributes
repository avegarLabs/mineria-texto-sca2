# Normalizar fin de línea a LF en el repositorio
* text=auto eol=lf

# Scripts de Windows necesitan CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Texto
*.py   text diff=python
*.md   text diff=markdown
*.sh   text eol=lf
*.csv  text
*.txt  text

# Binarios
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.xlsx binary
*.docx binary
